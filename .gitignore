# Data is never committed: rebuild it with `clim acquire && clim ingest`,
# verified against the checksums in manifests/.
data/

# Python
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Site
site/node_modules/
site/.svelte-kit/
site/build/
# Generated by `clim export` (derived from data/, covered by the same rule)
site/static/data/

# OS / editor
.DS_Store
.claude/settings.local.json
.env
